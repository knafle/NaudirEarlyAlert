# Telegram Bot Token (obtained from @BotFather)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Target coordinates (latitude / longitude)
ALERT_LAT=-34.3100
ALERT_LON=-58.7391

# Administrative zone / department name to match in SMN SAT alerts
ALERT_ZONE=Escobar

# Display location name for Telegram messages
LOCATION_NAME=El Naudir

# SQLite database file path (optional, default: subscribers.db)
DB_PATH=subscribers.db

# Polling intervals
SAT_POLL_INTERVAL_HOURS=0.5
ACP_POLL_INTERVAL_MINUTES=3

# Set to true to continuously poll ACP even if SAT is inactive (useful for testing)
FORCE_ACP_POLL=false

# Scrape.do API key for 24/7 autonomous Cloudflare bypass (free tier: 1000 requests/mo)
SCRAPEDO_API_KEY=

# River monitoring (Prefectura Naval Argentina) for El Niño / Sudestada flood alerts
ENABLE_RIVER_MONITORING=true
RIVER_POLL_INTERVAL_MINUTES=45
# Dedicated Scrape.do API key for river scraping (keeps SMN quota separate and intact)
RIVER_SCRAPEDO_API_KEY=

# Calibrated river alert thresholds (Prefectura Naval Argentina gauge scales)
# Benchmarked above the historic Dec 2023 storm (where Tigre reached 3.70 m and El Naudir had 0 street flooding)

# 1. Local Escobar (Canal Arias / Paraná de las Palmas - PNA scale)
# Calibrated for El Naudir: Alert at 3.80m (drain saturation), Extreme at 4.10m (low street level)
RIVER_THRESHOLD_ESCOBAR_ALERT=3.80
RIVER_THRESHOLD_ESCOBAR_EXTREME=4.10

# 2. Local Dique Luján (Río Luján / Canal Villanueva - PNA scale)
RIVER_THRESHOLD_DIQUE_LUJAN_ALERT=3.00
RIVER_THRESHOLD_DIQUE_LUJAN_EXTREME=3.30

# 3. Sudestada Tigre (Río de la Plata storm surges - Dec 2023 reached 3.70 m without flooding)
RIVER_THRESHOLD_TIGRE_ALERT=3.80
RIVER_THRESHOLD_TIGRE_EXTREME=4.05

# 4. Sudestada San Fernando
RIVER_THRESHOLD_SAN_FERNANDO_ALERT=3.80
RIVER_THRESHOLD_SAN_FERNANDO_EXTREME=4.05

# 5. Upstream Paraná River (Zárate - 6 to 12 hours advance warning)
# Early & Major triggers require downstream to be loaded/blocked (Tigre/Escobar high or rising).
# Extreme is the unilateral safety-valve trigger for unprecedented colossal volume (exceeds all-time 3.32m record).
RIVER_THRESHOLD_ZARATE_EARLY=2.50
RIVER_THRESHOLD_ZARATE_MAJOR=3.10
RIVER_THRESHOLD_ZARATE_EXTREME=3.80

# 6. Upstream Campana
RIVER_THRESHOLD_CAMPANA_EARLY=2.55
RIVER_THRESHOLD_CAMPANA_MAJOR=3.15
RIVER_THRESHOLD_CAMPANA_EXTREME=3.85
